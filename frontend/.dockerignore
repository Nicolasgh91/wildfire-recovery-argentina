# ── Dependencies (installed fresh in container) ──
node_modules

# ── Build outputs (generated in container) ──
dist
build

# ── Test tooling and artifacts ──
cypress
cypress.config.ts
playwright.config.ts
playwright-report
test-results
coverage
.nyc_output
src/**/*.test.*
src/**/*.spec.*
src/test

# ── Documentation and metadata ──
README.md
*.md

# ── Development configuration ──
.vscode
.idea
.eslintcache
eslint.config.js

# ── Environment and secrets ──
.env
.env.*
!.env.production

# ── OS and editor artifacts ──
.DS_Store
Thumbs.db
*.swp
*.swo

# ── Docker files (avoid recursive context) ──
Dockerfile
Dockerfile.*
.dockerignore

# ── Logs and temp ──
*.log
*.tmp
*.temp
npm-debug.log*

# ── Git ──
.git
.gitignore

# ── Cache ──
.cache
.parcel-cache
