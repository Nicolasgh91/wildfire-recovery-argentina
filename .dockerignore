# Git
.git
.gitignore

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments (match with and without trailing slash)
.venv
.venv/
venv
venv/
env
env/
ENV
ENV/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Logs
logs/
*.log
temp_files/

# Coverage and testing
htmlcov/
.coverage
.pytest_cache/
.tox/
.nyc_output/
coverage.xml
*.cover
.hypothesis/

# Documentation
docs/
*.md
!README.md

# MyPy cache (65 MB locally)
.mypy_cache/
.mypy_cache

# Frontend — the API/worker images don't need ANY frontend source.
# Exclude the entire tree; only the compiled static assets served by nginx
# are relevant, and those are built separately via the frontend Dockerfile.
frontend/

# Global node_modules catch-all (safety net for any nested npm projects)
**/node_modules/

# Data and cache
data/
cache/
*.cache

# Environment files — never bake secrets into the image
# Runtime secrets live in /home/opc/.env on the VM, not in the image.
.env
.env.*
!.env.template

# Temporary files
*.tmp
*.temp
*.bak

# Docker files (exclude from build context)
docker-compose.override.yml
Dockerfile.dev

# Secrets directory
secrets/

# Supabase local dev artifacts
supabase/.branches/
supabase/.temp/

# Test artifacts
tests/
pytest.ini
pyproject.toml

# CI/CD (not needed inside the image)
.github/

# Local scripts not needed at runtime
scripts/setup-ssl.sh
scripts/renew-ssl*.sh
scripts/verify-ssl.sh
scripts/analyze-disk-usage.sh
scripts/cleanup-docker.sh
scripts/monitor-disk-usage.sh

# Additional optimization exclusions
walkthrough.md
fix-docker-deployment.sh
nginx-temp.conf
certbot/
temp_files/
database/migrations/versions/*.py
!database/migrations/versions/__init__.py
